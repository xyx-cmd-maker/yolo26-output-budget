# ---- 数据：一律不入库 ----
data/raw/
data/interim/
data/processed/
*.zip
*.tar
*.tar.gz
*.7z

# ---- 权重：不入库（用 scripts/download_weights.* 重建）----
*.pt
*.pth
*.onnx
*.engine
*.mlpackage
*.tflite
results/checkpoints/*
!results/checkpoints/.gitkeep

# ---- 运行产物 ----
# ★ 注意：runs/records/ 与 runs/aggregated/ 是 AGENTS.md §0.2 指定的
#   "数字唯一来源"，**必须纳入版本控制**（下方用 ! 开白名单）。
#   被忽略的只是权重、日志、可视化这些可由记录重生成的中间产物。
runs/*
!runs/.gitkeep
!runs/records/
!runs/aggregated/
runs/**/weights/
logs/*
!logs/.gitkeep
wandb/

# ---- 探针与临时 ----
.probe/
*.tmp
*.blob
